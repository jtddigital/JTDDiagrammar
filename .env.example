# API server (packages/api). All optional; defaults shown.
# HOST=0.0.0.0
# PORT=8080
# BODY_LIMIT=1048576        # bytes (URS-API-006)
# MAX_NODES=1000
# MAX_EDGES=2000
# RENDER_TIMEOUT_MS=5000    # a render taking longer is killed: 422 limit.time
# RENDER_WORKERS=           # default: CPUs - 1, between 1 and 4
# WEB_DIST=                 # built web app to serve at /; default packages/web/dist if present

# P4 (AI generation, URS-AI-002/010): server-side only, never exposed to the browser.
# ANTHROPIC_API_KEY=
