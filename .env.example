# API server (packages/api). All optional; defaults shown.
# HOST=0.0.0.0
# PORT=8080
# BODY_LIMIT=1048576        # bytes (URS-API-006)
# MAX_NODES=1000
# MAX_EDGES=2000
# RENDER_TIMEOUT_MS=5000    # a render taking longer is killed: 422 limit.time
# RENDER_WORKERS=           # default: CPUs - 1, between 1 and 4
# WEB_DIST=                 # built web app to serve at /; default packages/web/dist if present
# REGISTRY_MODULE=@jtd/core # module exporting createRegistry(), to add diagram types without forking

# AI generation (POST /v1/generate). Disabled unless a credential is set. The key is read by the
# Anthropic SDK on the server only; it is never sent to the browser or logged (URS-AI-010).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high             # low | medium | high | xhigh | max
# AI_FALLBACKS=on            # server-side refusal fallbacks; "off" to disable
# AI_MAX_REPAIRS=2           # correction attempts after the first (0 allowed)
# AI_MAX_INPUT_TOKENS=200000 # checked with count_tokens before generating
# AI_MAX_FILES=5
# AI_MAX_FILE_BYTES=20000000
# AI_MAX_TOTAL_BYTES=20000000  # requests are capped at 32 MB with base64 included
# AI_MAX_PDF_PAGES=600
# AI_MAX_OUTPUT_TOKENS=64000
# AI_RATE_LIMIT=10          # AI requests per client per minute; 0 disables
# AI_PRICES=                # JSON {"model":{"input":4,"output":20,"cacheRead":0.2,"cacheWrite":5}}, USD per million tokens
