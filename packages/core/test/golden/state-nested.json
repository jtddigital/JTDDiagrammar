{
  "version": "1",
  "type": "state",
  "title": "Two levels of nesting",
  "states": [
    {
      "id": "start",
      "kind": "initial",
      "to": [
        {
          "state": "off"
        }
      ]
    },
    {
      "id": "off",
      "label": "Off",
      "to": [
        {
          "state": "machine",
          "event": "power on"
        }
      ]
    },
    {
      "id": "machine",
      "label": "Machine",
      "states": [
        {
          "id": "m0",
          "kind": "initial",
          "to": [
            {
              "state": "idle"
            }
          ]
        },
        {
          "id": "idle",
          "label": "Idle",
          "to": [
            {
              "state": "running",
              "event": "start"
            }
          ]
        },
        {
          "id": "running",
          "label": "Running",
          "states": [
            {
              "id": "r0",
              "kind": "initial",
              "to": [
                {
                  "state": "slow"
                }
              ]
            },
            {
              "id": "slow",
              "label": "Slow",
              "to": [
                {
                  "state": "fast",
                  "event": "boost"
                }
              ]
            },
            {
              "id": "fast",
              "label": "Fast",
              "to": [
                {
                  "state": "slow",
                  "event": "ease"
                },
                {
                  "state": "fault",
                  "event": "overheat"
                }
              ]
            }
          ]
        }
      ],
      "to": [
        {
          "state": "off",
          "event": "power off"
        }
      ]
    },
    {
      "id": "fault",
      "label": "Fault",
      "to": [
        {
          "state": "idle",
          "event": "reset"
        }
      ]
    }
  ]
}
