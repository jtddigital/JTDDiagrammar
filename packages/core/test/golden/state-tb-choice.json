{
  "version": "1",
  "type": "state",
  "title": "Login (top to bottom, choice)",
  "direction": "TB",
  "states": [
    {
      "id": "start",
      "kind": "initial",
      "to": [
        {
          "state": "entering"
        }
      ]
    },
    {
      "id": "entering",
      "label": "Entering credentials",
      "to": [
        {
          "state": "check",
          "event": "submit"
        }
      ]
    },
    {
      "id": "check",
      "kind": "choice",
      "to": [
        {
          "state": "in",
          "guard": "valid"
        },
        {
          "state": "entering",
          "guard": "invalid",
          "action": "count attempt"
        },
        {
          "state": "locked",
          "guard": "attempts > 3"
        }
      ]
    },
    {
      "id": "locked",
      "label": "Locked"
    },
    {
      "id": "in",
      "label": "Signed in",
      "to": [
        {
          "state": "end",
          "event": "sign out"
        }
      ]
    },
    {
      "id": "end",
      "kind": "final"
    }
  ]
}
