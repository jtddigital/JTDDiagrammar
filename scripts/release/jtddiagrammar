#!/usr/bin/env bash
# JTDDiagrammar launcher (URS-NF-011).
#   jtddiagrammar [start] [--port N] [--no-open]   start the app and open it in the browser
#   jtddiagrammar update [vX.Y.Z]                  install the latest (or a given) release
#   jtddiagrammar restart [--port N] [--no-open]   stop the running app and start it again
#   jtddiagrammar stop                              stop the running app
#   jtddiagrammar version
set -euo pipefail

APP="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JTD_HOME="${JTD_HOME:-$(dirname "$(dirname "$APP")")}"
export JTD_HOME

cmd=start
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then cmd="$1"; shift; fi

# The server this launcher started, so a later run can stop or restart it.
pidfile="$JTD_HOME/server.pid"
stop_server() {
  [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null && rm -f "$pidfile"
}

case "$cmd" in
  version) cat "$APP/VERSION" ;;
  update) exec bash "$APP/bin/install.sh" "$@" ;;
  stop) if stop_server; then echo "JTDDiagrammar stopped"; else echo "JTDDiagrammar is not running"; fi ;;
  restart) stop_server || true; sleep 1; exec "$0" start "$@" ;;
  start)
    if [ -f "$JTD_HOME/config.env" ]; then set -a; . "$JTD_HOME/config.env"; set +a; fi
    export PORT="${PORT:-8080}" HOST="${HOST:-127.0.0.1}" NODE_ENV=production
    open=1
    while [ $# -gt 0 ]; do
      case "$1" in
        --port) PORT="$2"; shift 2 ;;
        --no-open) open=0; shift ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
      esac
    done
    url="http://localhost:$PORT"
    # Probe over IPv4, as the Windows launcher does; localhost may try ::1 first.
    case "$HOST" in 127.0.0.1|0.0.0.0|localhost) probe="http://127.0.0.1:$PORT" ;; *) probe="$url" ;; esac
    browse() {
      [ "$open" = 1 ] || return 0
      if [ "$(uname)" = Darwin ]; then open "$url"
      elif command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1 &
      fi
    }
    installed="$(cat "$APP/VERSION")"
    if health="$(curl -sf "$probe/health" 2>/dev/null)"; then
      # Already running: reuse it, unless it is an older version or config.env changed since it started.
      running="$(printf '%s' "$health" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
      started="$(printf '%s' "$health" | sed -n 's/.*"startedAt":\([0-9]*\).*/\1/p')"
      changed=0
      if [ -f "$JTD_HOME/config.env" ]; then changed="$(date -r "$JTD_HOME/config.env" +%s)000"; fi
      if [ "$running" = "$installed" ] && [ "${started:-0}" -ge "$changed" ]; then echo "already running at $url"; browse; exit 0; fi
      why="settings in config.env changed"; [ "$running" = "$installed" ] || why="${running:-an older version} is running, $installed is installed"
      if ! stop_server; then
        echo "JTDDiagrammar is already running at $url, but $why." >&2
        echo "Close the window it runs in (or press Ctrl+C there), then run jtddiagrammar again." >&2
        exit 1
      fi
      echo "Restarting: $why"
      for _ in $(seq 1 20); do curl -sf "$probe/health" >/dev/null 2>&1 || break; sleep 0.5; done
    fi
    node "$APP/packages/api/src/server.ts" &
    pid=$!
    echo "$pid" > "$pidfile"
    trap 'kill $pid 2>/dev/null || true; [ "$(cat "$pidfile" 2>/dev/null)" = "$pid" ] && rm -f "$pidfile"' INT TERM EXIT
    for _ in $(seq 1 60); do
      curl -sf "$probe/health" >/dev/null 2>&1 && break
      kill -0 $pid 2>/dev/null || { echo "the server failed to start" >&2; exit 1; }
      sleep 0.5
    done
    echo "JTDDiagrammar $installed at $url (Ctrl+C to stop)"
    browse
    wait $pid
    ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
